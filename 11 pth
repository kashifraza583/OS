
#include <stdio.h>
#include <pthread.h>

int n;
long long sum = 0;

void *calculate_sum(void *arg)
{
    for (int i = 1; i <= n; i++)
    {
        sum += i;
    }

    return NULL;
}

int main()
{
    pthread_t thread;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    pthread_create(&thread, NULL, calculate_sum, NULL);

    pthread_join(thread, NULL);

    printf("Sum of first %d natural numbers = %lld\n", n, sum);

    return 0;
}
