
#include <stdio.h>
#include <pthread.h>

int n;
int sum = 0;

void *calculate(void *arg)
{
    int i;

    for(i = 1; i <= n; i++)
    {
        sum = sum + i;
    }

    return NULL;
}

int main()
{
    pthread_t t1;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    pthread_create(&t1, NULL, calculate, NULL);

    pthread_join(t1, NULL);

    printf("Sum of first %d natural numbers = %d\n", n, sum);

    return 0;
}
