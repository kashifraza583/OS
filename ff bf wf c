
#include <stdio.h>

int main()
{
    int nb, np, i, j;
    int block[20], process[20];
    int temp[20], allocation[20];

    printf("Enter number of memory blocks: ");
    scanf("%d", &nb);

    for(i = 0; i < nb; i++)
    {
        printf("Enter size of block %d: ", i + 1);
        scanf("%d", &block[i]);
    }

    printf("Enter number of processes: ");
    scanf("%d", &np);

    for(i = 0; i < np; i++)
    {
        printf("Enter size of process %d: ", i + 1);
        scanf("%d", &process[i]);
    }

    // FIRST FIT

    for(i = 0; i < nb; i++)
        temp[i] = block[i];

    for(i = 0; i < np; i++)
        allocation[i] = -1;

    for(i = 0; i < np; i++)
    {
        for(j = 0; j < nb; j++)
        {
            if(temp[j] >= process[i])
            {
                allocation[i] = j;
                temp[j] = temp[j] - process[i];
                break;
            }
        }
    }

    printf("\nFIRST FIT ALLOCATION\n");

    for(i = 0; i < np; i++)
    {
        if(allocation[i] != -1)
            printf("P%d allocated to Block %d\n", i+1, allocation[i]+1);
        else
            printf("P%d Not Allocated\n", i+1);
    }

    // BEST FIT

    for(i = 0; i < nb; i++)
        temp[i] = block[i];

    for(i = 0; i < np; i++)
        allocation[i] = -1;

    for(i = 0; i < np; i++)
    {
        int best = -1;

        for(j = 0; j < nb; j++)
        {
            if(temp[j] >= process[i])
            {
                if(best == -1 || temp[j] < temp[best])
                    best = j;
            }
        }

        if(best != -1)
        {
            allocation[i] = best;
            temp[best] = temp[best] - process[i];
        }
    }

    printf("\nBEST FIT ALLOCATION\n");

    for(i = 0; i < np; i++)
    {
        if(allocation[i] != -1)
            printf("P%d allocated to Block %d\n", i+1, allocation[i]+1);
        else
            printf("P%d Not Allocated\n", i+1);
    }

    // WORST FIT

    for(i = 0; i < nb; i++)
        temp[i] = block[i];

    for(i = 0; i < np; i++)
        allocation[i] = -1;

    for(i = 0; i < np; i++)
    {
        int worst = -1;

        for(j = 0; j < nb; j++)
        {
            if(temp[j] >= process[i])
            {
                if(worst == -1 || temp[j] > temp[worst])
                    worst = j;
            }
        }

        if(worst != -1)
        {
            allocation[i] = worst;
            temp[worst] = temp[worst] - process[i];
        }
    }

    printf("\nWORST FIT ALLOCATION\n");

    for(i = 0; i < np; i++)
    {
        if(allocation[i] != -1)
            printf("P%d allocated to Block %d\n", i+1, allocation[i]+1);
        else
            printf("P%d Not Allocated\n", i+1);
    }

    return 0;
}
